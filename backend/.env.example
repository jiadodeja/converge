# Converge Backend Environment Configuration

# Which AI to use: gemini or openai
AI_PROVIDER=gemini

# Get a free Gemini key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: change these if Google renames the models
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=hr_policies
PDF_PATH=./data/handbook.pdf

# Slack (see setup steps): bot token starts with xoxb-
SLACK_BOT_TOKEN=your_slack_bot_token_here
